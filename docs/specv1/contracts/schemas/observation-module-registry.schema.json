{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astraeus.example/schemas/observation-module-registry.schema.json",
  "title": "ObservationModuleRegistry",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_version", "modules"],
  "properties": {
    "registry_version": {"type": "string", "const": "1.0.0-draft.1"},
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/module"}
    }
  },
  "$defs": {
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module_id",
        "title",
        "version",
        "status",
        "owner",
        "subject_classes",
        "occurrence_semantics",
        "geometry_types",
        "supported_observation_modes",
        "supported_objectives",
        "score_components",
        "required_evidence_classes",
        "optional_evidence_classes",
        "request_schema",
        "result_schema",
        "science_spec",
        "safety_spec",
        "safety_policy",
        "scoring_rule",
        "region_limitations",
        "verification_refs",
        "approval"
      ],
      "properties": {
        "module_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
        "title": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$"},
        "status": {"enum": ["planned", "proposed", "accepted", "active", "superseded"]},
        "owner": {"type": "string", "minLength": 1},
        "subject_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["persistent_target", "scheduled_occurrence", "forecast_phenomenon", "discovered_transient"]}
        },
        "occurrence_semantics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["deterministic_calculation", "issued_forecast", "catalogue_updated", "observation_updated"]}
        },
        "geometry_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["point", "disc", "track", "sky_region", "extended_field", "full_sky", "volume"]}
        },
        "supported_observation_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["naked_eye", "filtered_visual", "binocular", "telescope_visual", "fixed_camera", "filtered_camera", "tracking_camera"]}
        },
        "supported_objectives": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["visual_detection", "visual_detail", "photographic_capture", "timelapse", "scientific_timing"]}
        },
        "score_components": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "physical_signal_potential",
              "geometric_visibility",
              "atmospheric_transmission",
              "background_contrast",
              "observer_equipment_detectability",
              "usable_duration",
              "operational_feasibility",
              "travel_adjusted_utility"
            ]
          }
        },
        "required_evidence_classes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "optional_evidence_classes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "request_schema": {"type": "string", "minLength": 1},
        "result_schema": {"type": "string", "minLength": 1},
        "science_spec": {"type": "string", "minLength": 1},
        "safety_spec": {"type": "string", "minLength": 1},
        "safety_policy": {"type": "string", "minLength": 1},
        "scoring_rule": {"type": "string", "minLength": 1},
        "region_limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "verification_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z0-9]+-[A-Z0-9]+-[0-9]{3}-T[0-9]{2}$"}},
        "approval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["accepted_by", "accepted_at", "activated_by", "activated_at"],
          "properties": {
            "accepted_by": {"type": ["string", "null"]},
            "accepted_at": {"type": ["string", "null"], "format": "date-time"},
            "activated_by": {"type": ["string", "null"]},
            "activated_at": {"type": ["string", "null"], "format": "date-time"}
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"enum": ["accepted", "active"]}}},
          "then": {
            "properties": {
              "approval": {
                "properties": {
                  "accepted_by": {"const": "@TusharSariya"},
                  "accepted_at": {"type": "string", "format": "date-time"}
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "active"}}},
          "then": {
            "properties": {
              "approval": {
                "properties": {
                  "activated_by": {"const": "@TusharSariya"},
                  "activated_at": {"type": "string", "format": "date-time"}
                }
              }
            }
          }
        }
      ]
    }
  }
}
