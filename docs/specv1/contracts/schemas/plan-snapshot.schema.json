{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astraeus.example/schemas/plan-snapshot.schema.json",
  "title": "PlanSnapshotEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "snapshot_id", "module_id", "module_version", "subject_id", "occurrence_id", "comparison_key", "issued_at", "stale_at", "expires_at", "key_id", "signature_algorithm", "canonicalization", "payload_sha256", "signature", "payload"],
  "properties": {
    "schema_version": {"const": "1.0.0-draft.2"},
    "snapshot_id": {"type": "string", "minLength": 1},
    "module_id": {"type": "string", "minLength": 1},
    "module_version": {"type": "string", "minLength": 1},
    "subject_id": {"type": "string", "minLength": 1},
    "occurrence_id": {"type": ["string", "null"], "minLength": 1},
    "comparison_key": {"type": "string", "pattern": "^cmp_[A-Za-z0-9_-]{20,64}$"},
    "issued_at": {"type": "string", "format": "date-time"},
    "stale_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "key_id": {"type": "string", "minLength": 1},
    "signature_algorithm": {"enum": ["Ed25519"]},
    "canonicalization": {"enum": ["JCS-RFC8785"]},
    "payload_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "signature": {"type": "string", "contentEncoding": "base64"},
    "payload": {"type": "object"}
  }
}
