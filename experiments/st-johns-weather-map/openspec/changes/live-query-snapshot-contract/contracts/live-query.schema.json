{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astraeus.invalid/experiments/weather/live-query.schema.json",
  "$defs": {
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latitude", "longitude", "valid_time", "window_start", "window_end", "product", "layer_ids", "field_selectors"],
      "properties": {
        "latitude": {"type": "number", "minimum": -90, "maximum": 90},
        "longitude": {"type": "number", "minimum": -180, "maximum": 180},
        "valid_time": {"type": "string", "format": "date-time"},
        "window_start": {"type": "string", "format": "date-time"},
        "window_end": {"type": "string", "format": "date-time"},
        "product": {"type": ["string", "null"]},
        "layer_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "field_selectors": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "expected_fragment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "provider_run_id", "logical_artifact", "valid_time_or_interval", "field_group", "member_group", "fields", "geography", "max_received_bytes", "max_staged_bytes"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "provider_run_id": {"type": "string", "minLength": 1},
        "logical_artifact": {"type": "string", "minLength": 1},
        "valid_time_or_interval": {"oneOf": [{"type": "string", "format": "date-time"}, {"type": "object", "additionalProperties": false, "required": ["start", "end"], "properties": {"start": {"type": "string", "format": "date-time"}, "end": {"type": "string", "format": "date-time"}}}]},
        "field_group": {"type": "string", "minLength": 1},
        "member_group": {"type": "string", "minLength": 1},
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "units", "level"],
            "properties": {
              "key": {"type": "string", "minLength": 1},
              "units": {"type": "string", "minLength": 1},
              "level": {"type": ["string", "null"]}
            }
          }
        },
        "geography": {
          "type": "object",
          "additionalProperties": false,
          "required": ["crs", "bounds"],
          "properties": {
            "crs": {"type": "string", "minLength": 1},
            "bounds": {
              "type": "object",
              "additionalProperties": false,
              "required": ["west", "south", "east", "north"],
              "properties": {
                "west": {"type": "number", "minimum": -180, "maximum": 180},
                "south": {"type": "number", "minimum": -90, "maximum": 90},
                "east": {"type": "number", "minimum": -180, "maximum": 180},
                "north": {"type": "number", "minimum": -90, "maximum": 90}
              }
            }
          }
        },
        "max_received_bytes": {"type": "integer", "minimum": 1},
        "max_staged_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot_id", "selection", "selected_at", "expires_at", "state", "operation_id", "fencing_token", "reservation_state", "reserved_bytes", "revision_set"],
      "properties": {
        "snapshot_id": {"type": "string", "minLength": 1},
        "selection": {"$ref": "#/$defs/selection"},
        "selected_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "state": {"enum": ["current", "changed", "expired", "unavailable"]},
        "operation_id": {"type": "string", "format": "uuid"},
        "fencing_token": {"type": "integer", "minimum": 1},
        "reservation_state": {"enum": ["active", "revoking", "releasable", "released"]},
        "reserved_bytes": {"type": "integer", "minimum": 0},
        "revision_set": {
          "type": "object",
          "additionalProperties": false,
          "required": ["manifest_revisions", "registry_revision", "field_catalogue_revision", "derivation_versions", "inventory_revision"],
          "properties": {
            "manifest_revisions": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["source_id", "logical_stream", "revision_id"],
                "properties": {
                  "source_id": {"type": "string"},
                  "logical_stream": {"type": "string"},
                  "revision_id": {"type": "string"}
                }
              }
            },
            "registry_revision": {"type": "string"},
            "field_catalogue_revision": {"type": "string"},
            "derivation_versions": {"type": "object", "additionalProperties": {"type": "string"}},
            "inventory_revision": {"type": "string"}
          }
        }
      }
    },
    "refresh_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline_snapshot_id", "selection", "requested_source_ids", "canonical_selection_digest"],
      "properties": {
        "baseline_snapshot_id": {"type": "string", "minLength": 1},
        "selection": {"$ref": "#/$defs/selection"},
        "requested_source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "canonical_selection_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "source_outcome": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "state", "manifest_revision", "fragment_outcomes"],
      "properties": {"source_id": {"type": "string", "minLength": 1}, "state": {"enum": ["succeeded", "failed", "cancelled"]}, "manifest_revision": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]}, "fragment_outcomes": {"type": "array", "items": {"$ref": "#/$defs/fragment_outcome"}}}
    },
    "fragment_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "fragment_key", "outcome", "manifest_revision"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "fragment_key": {"type": "string", "minLength": 1},
        "outcome": {"enum": ["cache_hit", "published", "nothing_available", "blocked", "retrieval_failed", "quota_exceeded", "upstream_budget_exhausted"]},
        "manifest_revision": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]}
      }
    },
    "refresh_job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id", "idempotency_key", "baseline_snapshot_id", "canonical_selection_digest", "operation_id", "fencing_token", "reservation_state", "state", "provider_payload_requests", "received_bytes", "source_outcomes"],
      "properties": {
        "job_id": {"type": "string"},
        "idempotency_key": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "baseline_snapshot_id": {"type": "string"},
        "canonical_selection_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "operation_id": {"type": "string", "format": "uuid"},
        "fencing_token": {"type": "integer", "minimum": 1},
        "reservation_state": {"enum": ["active", "revoking", "releasable", "released"]},
        "state": {"enum": ["queued", "running", "succeeded", "partial", "failed", "cancelled"]},
        "provider_payload_requests": {"type": "integer", "minimum": 0},
        "received_bytes": {"type": "integer", "minimum": 0},
        "source_outcomes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source_outcome"}}
      }
    },
    "live_proxy_raster": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_basis", "requested_time", "served_valid_time", "served_reference_time", "retrieval_completed_at", "cache_status"],
      "properties": {"evidence_basis": {"const": "live_proxy"}, "requested_time": {"type": "string", "format": "date-time"}, "served_valid_time": {"type": "string", "format": "date-time"}, "served_reference_time": {"type": ["string", "null"], "format": "date-time"}, "retrieval_completed_at": {"type": "string", "format": "date-time"}, "cache_status": {"enum": ["hit", "miss"]}}
    },
    "replacement_bundle": {
      "type": "object", "additionalProperties": false,
      "required": ["snapshot_id", "timeline_snapshot_id", "layers_snapshot_id", "point_snapshot_id"],
      "properties": {"snapshot_id": {"type": "string"}, "timeline_snapshot_id": {"type": "string"}, "layers_snapshot_id": {"type": "string"}, "point_snapshot_id": {"type": "string"}}
    }
  }
}
