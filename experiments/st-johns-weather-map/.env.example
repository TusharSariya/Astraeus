# Local-only development values for an isolated research stack. These are NOT
# provider credentials and must never be reused outside this Compose project.

# Fail-closed data mode: live | fixture. An unset or unrecognised value is
# treated as unavailable, never as fixture, so an outage cannot quietly serve
# synthetic values.
WEATHER_DATA_MODE=live

POSTGRES_USER=weather
POSTGRES_PASSWORD=weather-local-only
POSTGRES_DB=weather

# Root credentials are used by the one-shot minio-bootstrap service only.
MINIO_ROOT_USER=weather-local
MINIO_ROOT_PASSWORD=weather-local-only
WEATHER_MINIO_BUCKET=weather-artifacts
WEATHER_STORAGE_CAP=25GiB

# Least-privilege service users created by minio-bootstrap. The worker writes
# and prunes objects in one bucket; the API and tile server only read.
WEATHER_MINIO_WRITER_KEY=weather-writer
WEATHER_MINIO_WRITER_SECRET=weather-writer-local-only
WEATHER_MINIO_READER_KEY=weather-reader
WEATHER_MINIO_READER_SECRET=weather-reader-local-only

# Host-port overrides. Every port binds to 127.0.0.1 only.
WEATHER_WEB_PORT=5173
WEATHER_API_PORT=8000
WEATHER_MINIO_PORT=9000
WEATHER_MINIO_CONSOLE_PORT=9001
WEATHER_TITILER_PORT=8001

# ---------------------------------------------------------------------------
# Provider credentials — ALL OPTIONAL, ALL BLANK BY DEFAULT.
#
# Leave a value blank and its source simply stays non-active with a stated
# reason. Nothing crashes, no other source is affected, and no substituted
# value is ever shown in place of evidence that was not retrieved.
#
# Copy this file to `.env` (already gitignored) and fill in only what you want.
# See docs/credentials.md for where to obtain each one and what its licence
# permits — several of these forbid the caching or redistribution this
# experiment does, so read that before enabling one.
#
# NEVER commit a real key. NEVER paste one into a fixture, a test, a log, an
# issue, or a chat message.
# ---------------------------------------------------------------------------

# Copernicus Atmosphere Monitoring Service — aerosols, AOD, PM, composition.
# Free account. https://ads.atmosphere.copernicus.eu/how-to-api
WEATHER_SECRET_COPERNICUS_ADS_TOKEN=

# NASA Earthdata — MODIS/VIIRS/MAIAC satellite aerosol.
# Free account. https://urs.earthdata.nasa.gov/users/new
WEATHER_SECRET_NASA_EARTHDATA_TOKEN=

# NOAA MADIS — quality-controlled mesonet/radiosonde/profiler observations.
# Free account, but you are assigned a distribution category and SOME MESONETS
# FORBID REDISTRIBUTION. Read docs/credentials.md before enabling.
# https://madis-data.ncep.noaa.gov/index.html
WEATHER_SECRET_MADIS_TOKEN=

# PurpleAir — low-cost PM sensors. Key is free to request; terms are pending
# review in this registry. https://develop.purpleair.com/keys
WEATHER_SECRET_PURPLEAIR_API_KEY=

# OpenAQ — aggregated air-quality observations.
# Free key. https://explore.openaq.org/register
WEATHER_SECRET_OPENAQ_API_KEY=

# NL 511 — Newfoundland road conditions, cameras, ferries, advisories.
# Free developer key. Throttled to 10 calls per 60 seconds.
# Camera image display rights are NOT yet cleared. https://511nl.ca/developers/doc
WEATHER_SECRET_NL511_API_KEY=b36e3dbcf26c4b6e8f9ac8cd972e8994

# Google WeatherNext 2 — research comparison only. Requires an approved data
# request; downstream licence terms are unresolved.
# https://developers.google.com/weathernext/guides/access-forecast
WEATHER_SECRET_GOOGLE_WEATHERNEXT_TOKEN=
