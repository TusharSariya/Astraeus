{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astraeus.invalid/experiments/st-johns-weather-map/source-registry.schema.json",
  "title": "St. John's weather evidence source registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_version", "as_of", "classification", "sources"],
  "properties": {
    "registry_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "as_of": {"type": "string", "format": "date"},
    "classification": {"const": "experiment"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    }
  },
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1},
    "url": {"type": "string", "pattern": "^https://"},
    "status": {
      "enum": ["active", "implementing", "credential_required", "licence_review", "unavailable", "duplicate_evidence", "unsupported_field", "retired", "rejected"]
    },
    "delivery_kind": {
      "description": "How this source's values reach the deployment. 'published_cell' is the producer's own grid or observation; 'reprocessed' is an intermediary's transformation of the producer's field; 'intermediary_derived' is a value the intermediary computed from the producer's fields by the intermediary's own method, which the producer never published.",
      "enum": ["published_cell", "reprocessed", "intermediary_derived"]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "status", "reason", "producer", "product", "documentation_urls", "access_endpoints", "integration", "variables", "coverage", "cadence", "forecast_horizon", "authentication", "licence", "attribution", "caching", "archival", "redistribution", "schema_version", "freshness_threshold", "poc_role", "consensus", "delivery_kind", "display_primary", "fixture_status", "live_smoke_test_status"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "category": {"$ref": "#/$defs/nonempty"},
        "status": {"$ref": "#/$defs/status"},
        "reason": {"$ref": "#/$defs/nonempty"},
        "producer": {"$ref": "#/$defs/nonempty"},
        "product": {"$ref": "#/$defs/nonempty"},
        "documentation_urls": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/url"}},
        "access_endpoints": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/url"}},
        "integration": {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "client", "metadata_contract"],
          "properties": {"kind": {"enum": ["official_sdk", "community_client", "generated_client", "typed_adapter", "raw_protocol", "link_only"]}, "client": {"$ref": "#/$defs/nonempty"}, "metadata_contract": {"$ref": "#/$defs/nonempty"}}
        },
        "variables": {
          "type": "array", "minItems": 1,
          "items": {"type": "object", "additionalProperties": false, "required": ["names", "levels"], "properties": {"names": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonempty"}}, "levels": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonempty"}}}}
        },
        "coverage": {"$ref": "#/$defs/nonempty"},
        "cadence": {"$ref": "#/$defs/nonempty"},
        "forecast_horizon": {"$ref": "#/$defs/nonempty"},
        "authentication": {
          "type": "object", "additionalProperties": false, "required": ["required", "mechanism", "registration_url"],
          "properties": {"required": {"type": "boolean"}, "mechanism": {"$ref": "#/$defs/nonempty"}, "registration_url": {"type": ["string", "null"], "pattern": "^https://"}}
        },
        "licence": {
          "type": "object", "additionalProperties": false, "required": ["name", "url", "review_state"],
          "properties": {"name": {"$ref": "#/$defs/nonempty"}, "url": {"$ref": "#/$defs/url"}, "review_state": {"enum": ["verified", "pending", "restricted", "unknown"]}}
        },
        "attribution": {"$ref": "#/$defs/nonempty"},
        "caching": {"$ref": "#/$defs/nonempty"},
        "archival": {"$ref": "#/$defs/nonempty"},
        "redistribution": {"$ref": "#/$defs/nonempty"},
        "schema_version": {"$ref": "#/$defs/nonempty"},
        "freshness_threshold": {"$ref": "#/$defs/nonempty"},
        "poc_role": {"$ref": "#/$defs/nonempty"},
        "consensus": {
          "type": "object", "additionalProperties": false, "required": ["eligible", "family", "reason"],
          "properties": {"eligible": {"type": "boolean"}, "family": {"type": ["string", "null"]}, "reason": {"$ref": "#/$defs/nonempty"}}
        },
        "delivery_kind": {"$ref": "#/$defs/delivery_kind"},
        "display_primary": {
          "description": "Whether this record's values may be what the map shows first. Only a published_cell record may be; the audit enforces it here rather than leaving it to the display layer.",
          "type": "boolean"
        },
        "intermediary": {
          "type": "object", "additionalProperties": false, "required": ["name", "method", "transformations"],
          "properties": {
            "name": {"$ref": "#/$defs/nonempty"},
            "method": {"type": ["string", "null"], "minLength": 1},
            "transformations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonempty"}}
          }
        },
        "field_delivery_kinds": {
          "description": "Per-field delivery kind, because one intermediary may deliver reprocessed and intermediary-derived fields for the same producer.",
          "type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/delivery_kind"}
        },
        "fixture_status": {"enum": ["passing", "planned", "blocked", "not_applicable"]},
        "live_smoke_test_status": {"enum": ["passing", "planned", "blocked", "not_applicable"]}
      }
    }
  }
}
